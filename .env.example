# Database Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=jobmatch_db
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/jobmatch_db

# AI & LLM Providers
# Set to 'mock' for instant offline development and demo without API keys
# Set to 'openai' or 'gemini' for production embeddings and reasoning
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here

# App Settings
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=3000
